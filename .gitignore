# Runtime / build artifacts - never commit
backend/venv/
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/dist/
mobile-app/web-build/
__pycache__/
*.pyc

# Local junk
*.log
.DS_Store
Thumbs.db

# Secrets - never commit API keys or access tokens
backend/access_key.txt
backend/replicate_api_token.txt
backend/huggingface_token.txt
backend/gemini_api_key.txt
mobile-app/.env
mobile-app/.env.local
mobile-app/.env.production
mobile-app/sentry.properties

# Runtime state
backend/slideshow_config.json

# Generated wallpapers are personal and this repo is public - never commit them.
# They live on the phone, on the server, and in C:\FrogPaperBackups on the PC.
backend/static/images/*
!backend/static/images/.gitkeep

# Screenshots of the app on the owner's phone - personal, stay local.
docs/screenshots/
