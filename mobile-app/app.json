{
  "expo": {
    "name": "FrogPaper Mobile",
    "slug": "frogpaper-mobile",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#140D1C",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#140D1C"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.frogpaper.mobile",
      "versionCode": 52,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SET_WALLPAPER",
        "android.permission.SET_WALLPAPER_HINTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#140D1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow FrogPaper to save your generated wallpapers to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./src/plugins/WallpaperManagerFix",
      "./src/plugins/SigningConfig",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#140D1C"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "22d0cc52-7a83-4ead-8088-4e3694fe1d55"
      }
    }
  }
}
